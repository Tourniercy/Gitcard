{
  "name": "github-stats-cards",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm -r typecheck",
    "test": "pnpm -r test",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "typescript": "^6.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0"
    }
  },
  "pnpm": {
    "overrides": {
      "undici": ">=6.29.1",
      "brace-expansion@>=2.0.0 <3.0.0": ">=2.1.7 <3",
      "brace-expansion@>=5.0.0 <6.0.0": ">=5.0.11 <6"
    }
  }
}
